+            )
+            handle.attrs["xml_annotation_invalidation_fingerprint"] = fingerprint
+            handle.attrs["xml_annotation_invalidation_source_h5_sha256"] = source_sha
+            handle.attrs["label_source"] = OUTPUT_TOKEN
