+#!/usr/bin/env bash
+set -euo pipefail
+
+PYTHON="${PYTHON:-/home/kodaira/anaconda3/envs/dualtrack311/bin/python}"
+REPO_ROOT="${REPO_ROOT:-/mnt/data/3d_projects/models/Stage2to4}"
