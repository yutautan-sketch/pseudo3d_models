+    for name in integer_fields:
+        dtype = np.int32 if name == "frame_order" else np.int64
+        result[name] = group[name][:].astype(dtype)
+    lengths = {
+        values.shape[0]
+        for values in result.values()
+        if isinstance(values, np.ndarray)
