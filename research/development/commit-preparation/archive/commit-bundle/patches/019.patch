+        "positive_points",
+        "ignore_points",
+        "background_points",
+        "positive_outside_cvat_mask_points",
+    )
+    for name in (*text_fields, *integer_fields):
+        _required_dataset(group, name, "manual_review_fullvideo_frames")
+    result = {
